{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostrace.local/schema/exclusion-policy-v1.json",
  "title": "GHOSTRACE versioned exclusion policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "version": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "rules": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "root", "action"],
            "properties": {
              "kind": { "const": "root" },
              "root": { "$ref": "#/$defs/opaque_identifier" },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "pattern", "action"],
            "properties": {
              "kind": { "const": "subtree" },
              "pattern": { "$ref": "#/$defs/pattern" },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "file_kind", "action"],
            "properties": {
              "kind": { "const": "file_kind" },
              "file_kind": { "enum": ["file", "directory", "symlink", "unknown"] },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "pattern", "action"],
            "properties": {
              "kind": { "const": "application" },
              "pattern": { "$ref": "#/$defs/pattern" },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "action"],
            "properties": {
              "kind": { "const": "temporary_file" },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "action"],
            "properties": {
              "kind": { "const": "vcs" },
              "action": { "$ref": "#/$defs/action" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "pattern", "action"],
            "properties": {
              "kind": { "const": "user" },
              "pattern": { "$ref": "#/$defs/pattern" },
              "action": { "$ref": "#/$defs/action" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "action": { "enum": ["allow", "summarize", "redact", "deny"] },
    "opaque_identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*[a-z0-9]$",
      "not": { "pattern": "\\.\\." }
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
