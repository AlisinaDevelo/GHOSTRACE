{
  "schema_version": 1,
  "deprecation_policy": {
    "minimum_window_releases": 2,
    "requires": [
      "announced_in",
      "removal_not_before",
      "migration_tool",
      "rollback_evidence",
      "release_note"
    ]
  },
  "formats": [
    {
      "id": "journal-database",
      "kind": "database",
      "format": "ghostrace-journal-v1 (migrations 0000-0005)",
      "current_version": 5,
      "supported_read": [
        1,
        2,
        3,
        4,
        5
      ],
      "write_version": 5,
      "golden": "migrations/0001_init.sql",
      "status": "supported",
      "cases": {
        "current": {
          "outcome": "accept",
          "test": "tests/compatibility_matrix.rs::legacy_journal_survives_upgrade_query_explain_export_verify_and_delete"
        },
        "backward": {
          "outcome": "accept_with_upgrade",
          "test": "tests/migrations.rs::legacy_v1_database_upgrades_and_reopens_idempotently"
        },
        "forward": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::partially_migrated_and_future_journals_are_refused"
        },
        "downgrade": {
          "outcome": "refuse",
          "test": "tests/migrations.rs::unsupported_downgrade_refuses_startup"
        },
        "partially_migrated": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::partially_migrated_and_future_journals_are_refused"
        },
        "corrupted": {
          "outcome": "refuse",
          "test": "tests/migrations.rs::modified_migration_refuses_startup_without_echoing_path"
        }
      }
    },
    {
      "id": "event-envelope",
      "kind": "json_contract",
      "format": "schemas/event-envelope-v1.json",
      "current_version": 1,
      "supported_read": [
        1
      ],
      "write_version": 1,
      "golden": "fixtures/event-envelope-v1.golden.json",
      "status": "supported",
      "cases": {
        "current": {
          "outcome": "accept",
          "test": "tests/compatibility_matrix.rs::event_envelope_v1_accepts_its_golden_and_refuses_every_other_variant"
        },
        "additive_optional_fields": {
          "outcome": "accept",
          "test": "tests/shell_run_wrapper.rs::wrapper_events_validate_against_the_published_event_schema"
        },
        "forward": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::event_envelope_v1_accepts_its_golden_and_refuses_every_other_variant"
        },
        "backward": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::event_envelope_v1_accepts_its_golden_and_refuses_every_other_variant"
        },
        "unknown_field": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::event_envelope_v1_accepts_its_golden_and_refuses_every_other_variant"
        },
        "corrupted": {
          "outcome": "refuse",
          "test": "tests/compatibility_matrix.rs::event_envelope_v1_accepts_its_golden_and_refuses_every_other_variant"
        }
      }
